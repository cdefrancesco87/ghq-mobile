{
  "expo": {
    "name": "GHQ Mobile",
    "slug": "ghq-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ch.ghq.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ch.ghq.mobile",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      "expo-task-manager",
      "expo-dev-client",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "react-native-cloud-storage",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.ch.ghq.mobile",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "GhqSmall",
              "displayName": "GHQ",
              "description": "Serie, livello e missioni rimaste",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            },
            {
              "name": "GhqMedium",
              "displayName": "GHQ – Oggi",
              "description": "Le missioni di oggi da completare con un tocco",
              "ios": {
                "supportedFamilies": ["systemMedium"]
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal"
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "GHQ legge passi, minuti di attività e ore di sonno solo per le missioni che colleghi, così si completano da sole.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "96871bff-4edc-49b4-8fe2-050e6547b52f"
      },
      "googleWebClientId": "C17-PLACEHOLDER"
    }
  }
}
